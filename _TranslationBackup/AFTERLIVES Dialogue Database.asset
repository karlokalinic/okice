      - title: Menu Text
        value:
        type: 0
        typeString:
      - title: Dialogue Text
        value: I really need access to the bridge
        type: 0
        typeString:
      - title: Sequence
        value:
        type: 0
        typeString:
      conversationID: 8
      isRoot: 0
