      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value:
        type: 0
        typeString:
      - title: Dialogue Text
        value: "The overseer hesitates.\n\n\"...really? If you do that, I think I'd be able to open the bridge, just for you. The soldiers might not notice.\n\nBut you have to convince my grandson to leave.\""
        type: 0
        typeString:
      - title: Sequence
        value:
        type: 0
