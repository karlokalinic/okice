      - title: Menu Text
        value:
        type: 0
        typeString:
      - title: Dialogue Text
        value: "\"Ne znam.!\" vikne nadzornica, glasnije nego što je namjeravala.\n\n\"Zaključao se u stanu. Ne znam. što ondje radi.\""
        type: 0
